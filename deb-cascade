#!/usr/bin/env bash
#
# deb-cascade — push a branch across all repos in dependency order, one
# build-order step at a time, monitoring CI and pausing for the manual /staging
# publish between steps.
#
# Usage: ./deb-cascade <branch> [<repo>...] [--skip <repo>]...
#
#   <branch>       branch to push in every repo, e.g. ubuntu/resolute
#   <repo>...      optional whitelist (default: all repos in build-order)
#   --skip <repo>  exclude a repo (repeatable). NOTE: skip a repo's dependents
#                  too, or their dep pre-check will fail on the missing package.
#
# For each build-order line (repos on a line build in parallel):
#   1. skip repos already published in /staging at the branch's version (so it is
#      safe to re-run after a failure or interruption),
#   2. push the rest (deb-push first verifies earlier steps are in /staging),
#   3. watch each CI build to completion, alerting on success and stopping on
#      failure,
#   4. pause for you to upload the built packages to /staging (manual signing
#      step), auto-rechecking until they appear, then continue to the next line.
#
# Requires woodpecker-cli, set up (woodpecker-cli setup) for the CI server.

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.bash"

STAGING="/staging"

[ $# -ge 1 ] || usage
case "$1" in -h|--help) usage 0 ;; esac
branch="$(expand_distro "$1")"; shift
only=() skip=()
while [ $# -gt 0 ]; do
    case "$1" in
        --skip) shift; [ $# -gt 0 ] || die "--skip needs a repo (or comma-separated list)"; IFS=, read -ra _sk <<< "$1"; skip+=("${_sk[@]}") ;;
        --skip=*) IFS=, read -ra _sk <<< "${1#--skip=}"; skip+=("${_sk[@]}") ;;
        -*) die "unknown option: $1" ;;
        *) only+=("$1") ;;
    esac
    shift
done
case "$branch" in debian/*|ubuntu/*) ;; *) die "branch must start with debian/ or ubuntu/" ;; esac

require_ci
require_repo_dist "$STAGING" "$branch"

want() {
    in_list "$1" "${skip[*]:-}" && return 1
    [ "${#only[@]}" -eq 0 ] && return 0
    in_list "$1" "${only[*]}"
}

read_build_order
stepno=0
for line in "${BUILD_STEPS[@]}"; do
    stepno=$((stepno + 1))
    read -ra all <<< "$line"
    repos=()
    for r in "${all[@]}"; do
        want "$r" || continue
        repo_skips_branch "$r" "$branch" && { msg "[$(cpkg "$r")] excluded from $branch — $C_DIM skipping$C_RESET"; continue; }
        repos+=("$r")
    done
    [ "${#repos[@]}" -gt 0 ] || continue

    msg ""
    msg "$C_HDR========== build step $stepno: ${repos[*]} ==========$C_RESET"

    # 1) reentrancy: drop repos already published in /staging.
    todo=()
    for r in "${repos[@]}"; do
        [ -d "$SP_ROOT/$r/.git" ] || die "repo '$r' not found — clone it first"
        if ! in_repo "$r" branch_exists "$branch"; then
            if in_repo "$r" family_base_exists "$branch"; then
                die "repo '$r' has no '$branch' branch — run: ./deb-add-distro-all $branch"
            fi
            msg "[$(cpkg "$r")] no ${branch%%/*} packaging — $C_DIM skipping$C_RESET"
            continue
        fi
        if in_repo "$r" published_in_repo "$STAGING" "$branch"; then
            msg "[$(cpkg "$r")] already in $STAGING — $C_DIM skipping$C_RESET"
        else
            todo+=("$r")
        fi
    done
    [ "${#todo[@]}" -gt 0 ] || { msg "step $stepno already complete"; continue; }

    # 2) push and watch (deb-push's dep pre-check enforces that earlier steps are staged).
    push_and_watch "$branch" "${todo[@]}"
    [ "${#MON_FAILED[@]}" -eq 0 ] ||
        die "CI failed for: $(cpkg "${MON_FAILED[*]}") — fix and re-run (finished steps are skipped)"

    # 3) staging barrier: manual publish, then re-check (in place) until present.
    msg ""
    msg "${C_OK}CI passed${C_RESET} for step $stepno: ${todo[*]}"
    wait_published "$STAGING" "$branch" "step $stepno" "${todo[@]}"
done

msg ""
msg "${C_OK}Cascade complete for $branch.${C_RESET}"
