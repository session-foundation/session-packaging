#!/usr/bin/env bash
#
# deb-ci-restart — restart the CI builds of distro branches, then watch them.
#
# Usage: ./deb-ci-restart <repo> [<branch-glob>...]
#
#   <repo>          managed checkout directory (e.g. oxen-mq)
#   <branch-glob>   which branches, as for deb-push: globs over the active distro
#                   list, or bare codenames, space- or comma-separated.
#                   Default: 'debian/*' 'ubuntu/*'.
#
# For each selected branch, finds the latest CI pipeline for the commit currently
# on origin and restarts it, whatever its state; one that's still running or
# queued is stopped first. It then watches the new builds to completion (the same
# display as deb-push) and exits non-zero if any fail.
#
# Interrupting the watch doesn't cancel the restarts. To resume watching, re-run
# deb-push, not this, which would restart them all again.

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.bash"

[ $# -ge 1 ] || usage
case "$1" in -h|--help) usage 0 ;; esac
repo="$1"; shift
resolve_repo "$repo"
require_ci

select_branches "$@"

msg "Fetching origin..."
git fetch -q origin

slug="$(origin_slug)"
[ -n "$slug" ] || die "couldn't determine the origin slug"

rid="$(ci_repo_id "$slug")"
[ -n "$rid" ] || die "$slug isn't an active repo on $CI_SERVER"

MON_ITEMS=()
fail=0
for b in "${SELECTED[@]}"; do
    sha="$(git rev-parse -q --verify "refs/remotes/origin/$b" || true)"
    if [ -z "$sha" ]; then
        msg ">> $(cpkg "$b") $C_DIM not on origin — skipping$C_RESET"
        continue
    fi
    num="$(ci_build_for "$rid" "$b" "$sha")"
    if [ -z "$num" ]; then
        warn "$b: no pipeline found for ${sha:0:10} — skipping"
        fail=1; continue
    fi
    st="$(ci_status "$rid" "$num")"
    # A still-running pipeline would otherwise keep going alongside the restart,
    # with both uploading the same packages.
    if ! ci_terminal "$st"; then
        msg ">> $(cpkg "$b") stopping $st #$num"
        ci_stop "$rid" "$num" || { warn "$b: failed to stop #$num — not restarting it"; fail=1; continue; }
    fi
    msg ">> $(cpkg "$b") restarting #$num"
    ci_restart "$rid" "$num" || { warn "$b: failed to restart #$num"; fail=1; continue; }
    MON_ITEMS+=("$b|$slug|$b|$sha|0|$num")
done
[ "${#MON_ITEMS[@]}" -gt 0 ] || die "nothing was restarted"

msg "${C_DIM}(Ctrl-C to stop watching; restarted builds keep running; re-run deb-push to resume watching)${C_RESET}"
monitor_ci
[ "${#MON_FAILED[@]}" -eq 0 ] || die "CI failed for: $(cpkg "${MON_FAILED[*]}")"
[ "$fail" = 0 ] || die "some branches couldn't be restarted (see above)"
msg "${C_OK}All CI builds passed.${C_RESET}"
